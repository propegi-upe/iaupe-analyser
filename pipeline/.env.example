# Template de variaveis de ambiente da pipeline. Copie para ".env" na raiz do
# projeto (nao aqui dentro de pipeline/) e preencha com valores reais - o
# arquivo .env real fica fora do git (ver .gitignore).
#
# Nenhum valor abaixo e real; sao so exemplos/defaults documentados.

# --- Gemini (analise dos editais) ---
GEMINI_API_KEY=sua_chave_aqui

# --- MongoDB Atlas ---
MONGODB_URI=mongodb+srv://usuario:senha@cluster.mongodb.net/?retryWrites=true
MONGODB_DB=iaupe-analyser
# 0/false desativa a persistencia mesmo com URI definida; "auto" (default) usa
# Mongo quando MONGODB_URI existe.
MONGODB_ENABLED=auto
MONGODB_SERVER_SELECTION_TIMEOUT_MS=30000
MONGODB_CONNECT_TIMEOUT_MS=30000
MONGODB_SOCKET_TIMEOUT_MS=30000

# --- Selecao de fonte/limite da pipeline principal ---
PIPELINE_SOURCE=facepe
PIPELINE_LIMIT=all

# --- Politicas de espera/retry ao coletar e analisar editais ---
SLEEP_ALREADY_EXISTS=5
SLEEP_NEW_PROCESS=60
SLEEP_EMPTY_TEXT=5
MAX_RETRIES_GEMINI=3

# --- SMTP (envio de e-mail) ---
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=seu_usuario
SMTP_PASS=sua_senha
SENDER_EMAIL=from@example.com
# aceita varios e-mails separados por virgula (vao em Cc no institucional)
RECIPIENT_EMAIL=to@example.com
SMTP_BCC_BATCH_SIZE=90
SMTP_SEND_DELAY_SECONDS=1.0

# --- Notificacao de docentes por area/segmento ---
# interruptor de emergencia: 0/false/no/off/disabled desliga so a notificacao
# de docentes, sem parar a coleta/analise de editais
NOTIFY_DOCENTES=1

# --- Lembretes de prazo (D-30/D-15/D-7) ---
DEADLINE_REMINDER_STEPS=30,15,7

# --- Backfill avulso de notificacao (main.py --notify-editais) ---
NOTIFY_SOURCES=all
NOTIFY_MAX_POR_DOCENTE=3
NOTIFY_MAX_EMAILS=300
NOTIFY_APPLY=0

# --- Ano-alvo de fontes especificas (opcional) ---
FACEPE_TARGET_YEAR=
CAPES_TARGET_YEAR=

# --- MongoDB Atlas API (usado só pelo workflow de CI para liberar o IP do runner) ---
ATLAS_PUBLIC_KEY=
ATLAS_PRIVATE_KEY=
ATLAS_PROJECT_ID=
